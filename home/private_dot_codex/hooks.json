{
    "$schema": "https://json.schemastore.org/codex-hooks.json",
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "command": "bash '/home/bogge/.codex/herdr-agent-state.sh' session",
                        "timeout": 10,
                        "type": "command"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "matcher": "null",
                "hooks": [
                    {
                        "type": "command",
                        "command": "hk agent stop-hook --target codex",
                        "timeout": 120
                    }
                ]
            }
        ]
    }
}
