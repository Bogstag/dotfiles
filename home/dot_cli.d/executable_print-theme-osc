#!/usr/bin/env -S usage bash
# shellcheck shell=bash
#USAGE cmd "print" help="Print OSC sequences" {
#USAGE   arg "<theme>"
#USAGE }

# Reverse of file:///usr/share/omarchy/bin/omarchy-theme-osc
# So it prints and not sets.

# summary=Print OSC sequences for an Omarchy color theme

case "$usage_cmd" in
  print) echo "Deploying to $usage_theme" ;;
esac

theme="${1:-${HOME}/.local/state/omarchy/current/theme/colours.toml}"

[[ -f ${theme} ]] || exit 0

declare -A colours

while IFS=$'\t' read -r key value; do
    colours[${key}]="${value}"
done < <(omarchy-theme-color --file "${theme}" --all)

my_emit_osc() {
    local code="$1"
    local key="$2"

    [[ -n ${colours[${key}]:-} ]] || return 0
    printf '\\033]%s;%s\\007' "${code}" "${colours[${key}]}"
}

my_emit_osc 10 foreground
my_emit_osc 11 background
my_emit_osc 12 cursor
my_emit_osc 17 selection_background
my_emit_osc 19 selection_foreground

for i in {0..15}; do
    [[ -n ${colours[color${i}]:-} ]] || continue
    printf '\\033]4;%d;%s\\007' "${i}" "${colours[color${i}]}"
done
