AddKeysToAgent yes
UseKeychain yes
# Managed by chezmoi. Bitwarden Desktop provides the SSH agent socket.
# Keys remain in Bitwarden; this file contains no key material.
Host github.com
    HostName ssh.github.com
    User git
    IdentityFile {{ .chezmoi.homeDir }}/.ssh/id_ed25519_git.pub
    IdentityAgent {{ .chezmoi.homeDir }}/.bitwarden-ssh-agent.sock
