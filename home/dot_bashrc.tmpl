#!{{ lookPath "bash" }}

# Omarchy defaults can be found here:
# /usr/share/omarchy/default/bash

{{- if eq .chezmoi.osRelease.id "omarchy" }}
{{ template "bashrc-omarchy.sh" . }}
{{ end -}}

# Aliases.
if [ -f "{{ .chezmoi.homeDir }}/.bash_aliases" ]; then
	source "{{ .chezmoi.homeDir }}/.bash_aliases"
fi

# .bashrc.d
if [ -d "{{ .chezmoi.homeDir }}/.bashrc.d" ]; then
    for config in "{{ .chezmoi.homeDir }}/.bashrc.d"/*.sh; do
        [ -r "$config" ] && source "$config"
    done
fi

{{- if ne .chezmoi.osRelease.id "omarchy" }}
# Not Omarchy
eval "$(mise activate bash)"
{{- end }}
