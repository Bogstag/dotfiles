#!/bin/bash

# Ta bort bindestreck i början, då funkar både "--openrouter" och "openrouter"
provider="${1#--}"

case "$provider" in
groq)
	url="https://api.groq.com/openai/v1/models"
	# jq="[.data[].id]"
	key="$GROQ_API_KEY"
	;;
google-generate | gog)
	url="https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
	# jq="[.models[].name]"
	key="?"
	# TODO: Auto filter model/
	;;
google-openai | goa)
	url="https://generativelanguage.googleapis.com/v1beta/openai/models"
	# jq="[.data[].id]"
	key="$GEMINI_API_KEY"
	# TODO: Auto filter model/
	;;
openrouter)
	url="https://openrouter.ai/api/v1/models"
	# jq="[.data[] | select(.id | endswith('free')) | .id]"
	key=""
	;;
opencode-zen | zen)
	url="https://opencode.ai/zen/v1/models"
	# jq="[.data[] | select(.id | endswith('free')) | .id]"
	key=""
	;;
*)
	echo "Fel: Okänd eller saknad leverantör."
	echo "Användning: freemodels [openrouter | opencode-zen]"
	exit 1
	;;
esac

if [ "$key" == "" ]; then
	# TODO: Replace jq filter with $jq
	curl -s "$url" | jq "[.data[] | select(.id | endswith(\"free\")) | .id]"
elif [ "$key" == "?" ]; then
	# TODO: Replace jq filter with $jq
	curl -s "$url" | jq "[.models[].name]"
else
	# TODO: Replace jq filter with $jq
	curl -s "$url" -H "Authorization: Bearer $key" | jq "[.data[].id]"
fi
