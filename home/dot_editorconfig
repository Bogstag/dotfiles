# EditorConfig is awesome: https://editorconfig.org
# top-most EditorConfig file
root = true

[*]
# Matches multiple files with brace expansion notation
# Set default charset
charset     = utf-8
end_of_line = lf

[*.{html}]
# 4 space indent
indent_style = space
indent_size    = 4,

[*.{cs,csx,vb,vbx,h,cpp,idl}]
indent_size              = 4
insert_final_newline     = true
trim_trailing_whitespace = true

[*.{js,ts,mjs,mts}]
# 4 space indent
indent_style = space
indent_size    = 4,

[[json]]
[*.json]
indent_size  = 2
indent_style = space

[[jsonc]]
[*.jsonc]
indent_size  = 2
indent_style = space

[*.{ruleset,config,nuspec,resx,vsixmanifest,vsct,runsettings}]
indent_size  = 2
indent_style = space

[*.{yaml,yml}]
indent_size  = 2
indent_style = space

[*.lua]
# see https://github.com/CppCXY/EmmyLuaCodeStyle
indent_size  = 4
indent_style = spacef

[*.ps1]
indent_size  = 4
indent_style = space

[*.py]
charset      = utf-8
indent_size  = 4
indent_style = space

[Dockerfile]
indent_size = 4
indent_style = space
binary_next_line = true

[[shell]]
# like -i=4
indent_style = space
indent_size = 4
charset                     = utf-8
insert_final_newline        = true
# shfmt
language_dialect   = auto
simplify           = true
binary_next_line   = true
case_indent        = true
space_redirects    = true
keep_padding       = false
function_next_line = false
block_next_line    = true
minify             = false
# shellcheck
shellcheck.external-sources = true
shellcheck.shell            = bash

[[bash]]
# like -i=4
indent_style = space
indent_size = 4
charset                     = utf-8
insert_final_newline        = true
# shfmt
language_dialect   = bash
simplify           = true
binary_next_line   = true
case_indent        = true
space_redirects    = true
keep_padding       = false
function_next_line = false
block_next_line    = true
minify             = false
# shellcheck
shellcheck.external-sources = true
shellcheck.shell            = bash

[*.{sh,inc,bash,command}]
# like -i=4
indent_style = space
indent_size = 4
charset                     = utf-8
insert_final_newline        = true
# shfmt
language_dialect   = auto
simplify           = true
binary_next_line   = true
case_indent        = true
space_redirects    = true
keep_padding       = false
function_next_line = false
block_next_line    = true
minify             = false
# shellcheck
shellcheck.external-sources = true
shellcheck.shell            = bash

[Makefile]
indent_style = tab

[package.json]
indent_size  = 2
indent_style = space

[renovate.json*]
indent_style = tab

[third_party/**]
# Ignore the entire "third_party" directory when calling shfmt on directories,
# such as "shfmt -l -w .". When formatting files directly,
# like "shfmt -w third_party/foo.sh" or "shfmt --filename=third_party/foo.sh",
# the ignore logic is applied only when the --apply-ignore flag is given.
ignore = true
