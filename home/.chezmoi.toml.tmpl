[scriptEnv]
  HOME = "{{ .chezmoi.destDir }}"
  XDG_CACHE_HOME="{{ .chezmoi.destDir }}/.cache"
  XDG_CONFIG_HOME="{{ .chezmoi.destDir }}/.config"
  XDG_DATA_HOME="{{ .chezmoi.destDir }}/.local/share"
  XDG_DESKTOP_DIR="{{ .chezmoi.destDir }}/"
  XDG_STATE_HOME="{{ .chezmoi.destDir }}/.local/state"

[data]
{{- if eq .chezmoi.os "linux" }}
	bws_access_token = {{ output "secret-tool" "lookup" "BWS_ACCESS" "TOKEN" | quote }}
	shell = "/usr/bin/bash"
{{- end }}
{{- if eq .chezmoi.os "windows" }}
	shell = "PowerShell"
	shellexe = "pwsh.exe"

	[cd]
	command = "pwsh"
	args = ["-NoProfile", "-NoLogo"]

	[interpreters.ps1]
	command = "pwsh"
	args = ["-NoLogo", "-NoProfile"]
{{- end }}

[edit]
	command = "code"
	args = ["--wait"]

[diff]
	# command = "hunk"
	# args = ["diff", "--files", "{{ `{{ .Destination }}` }}", "{{ `{{ .Target }}` }}"]
	pager = "delta --paging never"
	# pager = "hunk pager"

[merge]
	#command = "meld"
	command = "hunk difftool"
	args = ["{{ `{{ .Destination }}` }}", "{{ `{{ .Source }}` }}", "{{ `{{ .Target }}` }}"]

[template]
  options = ["missingkey=zero"]

[hooks]
read-source-state.pre = {command = "echo", args = ["pre-read-source-state-hook"]}
apply.post = {command = "echo", args = ["post-apply-hook"]}
add.post = {command = "echo", args = ["post-add-hook"]}

