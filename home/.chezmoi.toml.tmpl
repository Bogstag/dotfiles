#:schema https://www.schemastore.org/chezmoi.json
# file:///home/bogge/.config/chezmoi/chezmoi.toml
{{- /* Is it? */}}
{{- $is_wsl := false }}
{{- $is_windows := false }}
{{- $is_linux := false }}
{{- $is_omarchy := false }}
{{- /* It is? */}}
{{- if .chezmoi.kernel.osrelease | lower | contains "microsoft" }}
{{- 	$is_wsl = true }}
{{- end }}
{{- if eq .chezmoi.os "windows" }}
{{- 	$is_windows = true }}
{{- end }}
{{- if eq .chezmoi.os "linux" }}
{{- 	$is_linux = true }}
{{- 	if eq .chezmoi.osRelease.id "omarchy" }}
{{- 		$is_omarchy = true }}
{{- 	end }}
{{- end }}
{{- $chassisType := (output "hostnamectl" "--json=short" | fromJson).Chassis }}

[scriptEnv]
  HOME            = "{{- .chezmoi.destDir }}"
  XDG_CACHE_HOME  = "{{- .chezmoi.destDir }}/.cache"
  XDG_CONFIG_HOME = "{{- .chezmoi.destDir }}/.config"
  XDG_DATA_HOME   = "{{- .chezmoi.destDir }}/.local/share"
  XDG_DESKTOP_DIR = "{{- .chezmoi.destDir }}/"
  XDG_STATE_HOME  = "{{- .chezmoi.destDir }}/.local/state"
  computerType	  = "{{- $chassisType }}"
  is_linux	 	  = "{{- $is_linux }}"
  is_omarchy	  = "{{- $is_omarchy }}"
  is_windows	  = "{{- $is_windows }}"
  is_wsl		  = "{{- $is_wsl }}"

[data]
{{- if $is_linux }}
  bws_access_token = {{ output "secret-tool" "lookup" "BWS_ACCESS" "TOKEN" | quote }}
{{- end }}
  is_linux         = "{{- $is_linux }}"
  is_omarchy	   = "{{- $is_omarchy }}"
  is_windows	   = "{{- $is_windows }}"
  is_wsl		   = "{{- $is_wsl }}"
{{- if $is_windows }}
  shellexe = "pwsh.exe"
  [cd]
  command = "pwsh"
  args = ["-NoProfile", "-NoLogo"]
  [interpreters.ps1]
  command = "pwsh"
  args = ["-NoLogo", "-NoProfile"]
{{- end }}

[edit]
  args    = ["--wait"]
  command = "code"

[diff]
  pager = "delta --paging never"

[merge]
  args    = ["{{ `{{ .Destination }}` }}", "{{ `{{ .Source }}` }}", "{{ `{{ .Target }}` }}"]
  command = "hunk difftool"

[template]
  options = ["missingkey=zero"]

[hooks]
{{- if $is_linux }}
  add.post              = { command = "echo", args = ["post-add-hook"] }
  apply.post            = { command = "echo", args = ["post-apply-hook"] }
  read-source-state.pre = { command = "echo", args = ["pre-read-source-state-hook"] }
{{- end }}
