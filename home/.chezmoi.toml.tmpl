#:schema https://www.schemastore.org/chezmoi.json
# ~/.config/chezmoi/chezmoi.toml

{{- $is_wsl := false -}}
{{- if and .chezmoi.kernel (hasKey .chezmoi.kernel "osrelease") -}}
{{- $is_wsl = (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}
{{- end -}}

{{- $chassisType := (output "hostnamectl" "--json=short" | fromJson).Chassis }}

{{- if eq .chezmoi.os "windows" }}
  # Windows
{{- else if eq .chezmoi.os "linux" }}
  # All linux
{{- end }}

{{- if eq .chezmoi.osRelease.id "omarchy" }}
  # Omarchy
{{- else if .chezmoi.kernel.osrelease | lower | contains "microsoft" }}
  # WSL
{{- end }}

[scriptEnv]
  HOME = "{{ .chezmoi.homeDir }}"

[data]
  {{ if eq .chezmoi.os "linux" -}} bws_access_token = {{ output "secret-tool" "lookup" "BWS_ACCESS" "TOKEN" | quote }} {{- end }}

[edit]
  command = "code"
  args = ["--wait"]

[diff]
  exclude = ["externals"]
  pager = "delta"

[merge]
  command = "meld"
  args = ["{{ .Destination }}", "{{ .Source }}", "{{ .Target }}"]

[template]
  options = ["missingkey=zero"]
