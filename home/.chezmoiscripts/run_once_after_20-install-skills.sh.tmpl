#!/bin/bash
# shellcheck shell=sh
# chezmoi:template:left-delimiter="# {{" right-delimiter=}}

set -eu
if ! command -v npx >/dev/null 2>&1; then
	echo "npx saknas; installera Node.js innan Codex-skills installeras." >&2
	exit 1
fi

agents="# {{- .skills.agents | join " " }}"

# {{ range .skills.global }}
sourceUrl="# {{- .sourceUrl }}"
# {{- range .skill }}
skill="# {{ . }}"
if [ -d ~/.agents/skills/"${skill}" ]; then
	echo "Update ${skill}"
	npx --yes \
		skills update --global "${skill}"
else
	echo "Add ${skill}"
	npx --yes \
		skills add --global \
		--skill "${skill}" \
		--agent "${agents}" \
		"${sourceUrl}"
fi
# {{- end }}
