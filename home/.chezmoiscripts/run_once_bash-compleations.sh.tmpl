#!/bin/bash

{{- if eq .chezmoi.os "linux" }}
    {{ $shell := "bash" }}
	{{ range .completions.mise -}}
        {{ $current := . }}
        {{ $file := list "~/.local/share/bash-completion/completions/" $current.name | join "" }}
        # if [ ! -f {{ $file }} ];then
        echo "Adding completion for {{ $current.name }}"
        {{ $current.name }} {{ $current.cmd }} {{ $shell }} > {{ $file }}
        # fi
    {{ end -}}
{{- end }}

