#!/bin/sh
# Emit the Bitwarden SSH signing key in the format Git expects.
# The agent socket is deliberately explicit so Git also works outside a shell
# that has SSH_AUTH_SOCK exported.
set -eu

export SSH_AUTH_SOCK="{{ .chezmoi.homeDir }}/.bitwarden-ssh-agent.sock"

ssh-add -L | awk '
    $3 == "GithubSigningKey" {
        print "key::" $1 " " $2
        found = 1
        exit
    }
    END { exit(found ? 0 : 1) }
'
