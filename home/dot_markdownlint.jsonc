{
  // Defaults in this file is commented.
  "$schema": {
    "schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint/main/schema/markdownlint-config-schema-strict.json",
    "allowTrailingCommas": true,
  },
  // Default state for all rules
  "default": true,
  // Path to configuration file to extend
  // "extends": null,

  // region MD001 heading-incrementv0.41.1
  // Heading levels should only increment by one level at a time : https://github.com/DavidAnson/markdownlint/blob/main/doc/md001.md
  /*   "MD001": {
    // RegExp for matching title in front matter
    "front_matter_title": "^\\s*title\\s*[:=]",
  }, */
  // endregion

  // region MD003 heading-style
  // Heading style : https://github.com/DavidAnson/markdownlint/blob/main/doc/md003.md
  /*   "MD003": {
    // Heading style
    "style": "consistent",
  }, */
  // endregion

  // region MD004 ul-style
  // Unordered list style : https://github.com/DavidAnson/markdownlint/blob/main/doc/md004.md
  // List style
  // "MD004": {
  //   "style": "consistent",
  // },
  // endregion

  // region MD005 list-indent
  // Inconsistent indentation for list items at the same level : https://github.com/DavidAnson/markdownlint/blob/main/doc/md005.md
  // "MD005": true,
  // endregion

  // region MD007 ul-inden
  // Unordered list indentation : https://github.com/DavidAnson/markdownlint/blob/main/doc/md007.md
  /*   "MD007": {
    // Spaces for indent
    "indent": 2,
    // Whether to indent the first level of the list
    "start_indented": false,
    // Spaces for first level indent (when start_indented is set)
    "start_indent": 2,
  }, */
  // endregion

  // region MD009 no-trailing-space
  // Trailing spaces : https://github.com/DavidAnson/markdownlint/blob/main/doc/md009.md
  /*   "MD009": {
    // Spaces for line break
    "br_spaces": 2,
    // Include code blocks
    "code_blocks": false,
    // Allow spaces for empty lines in list items
    "list_item_empty_lines": false,
    // Include unnecessary breaks
    "strict": false,
  }, */
  // endregion

  // region MD010 no-hard-tab
  // Hard tabs : https://github.com/DavidAnson/markdownlint/blob/main/doc/md010.md
  /*   "MD010": {
    // Include code blocks
    "code_blocks": true,
    // Fenced code languages to ignore
    "ignore_code_languages": [],
    // Number of spaces for each hard tab
    "spaces_per_tab": 1,
  }, */
  // endregion

  // region MD011 no-reversed-link
  // Reversed link syntax : https://github.com/DavidAnson/markdownlint/blob/main/doc/md011.md
  // "MD011": true,
  // endregion

  // region MD012 no-multiple-blank
  // Multiple consecutive blank lines : https://github.com/DavidAnson/markdownlint/blob/main/doc/md012.md
  /*   "MD012": {
    // Consecutive blank lines
    "maximum": 1,
  }, */
  // endregion

  // region MD013 line-lengt
  // Line length : https://github.com/DavidAnson/markdownlint/blob/main/doc/md013.md
  "MD013": {
    // Number of characters
    "line_length": 120,
    // Number of characters for headings
    // "heading_line_length": 80,
    // Number of characters for code blocks
    "code_block_line_length": 100,
    // Include code blocks
    // "code_blocks": true,
    // Include tables
    "tables": false,
    // Include headings
    // "headings": true,
    // Strict length checking
    // "strict": false,
    // Stern length checking
    // "stern": false,
  },
  // endregion

  // region MD014 commands-show-outpu
  // Dollar signs used before commands without showing output : https://github.com/DavidAnson/markdownlint/blob/main/doc/md014.md
  // "MD014": true,
  // endregion

  // region MD018 no-missing-space-at
  // No space after hash on atx style heading : https://github.com/DavidAnson/markdownlint/blob/main/doc/md018.md
  // "MD018": true,
  // endregion

  // region MD019 no-multiple-space-at
  // Multiple spaces after hash on atx style heading : https://github.com/DavidAnson/markdownlint/blob/main/doc/md019.md
  // "MD019": true,
  // endregion

  // region MD020 no-missing-space-closed-at
  // No space inside hashes on closed atx style heading : https://github.com/DavidAnson/markdownlint/blob/main/doc/md020.md
  // "MD020": true,
  // endregion

  // region MD021 no-multiple-space-closed-at
  // Multiple spaces inside hashes on closed atx style heading : https://github.com/DavidAnson/markdownlint/blob/main/doc/md021.md
  // "MD021": true,
  // endregion

  // region MD022 blanks-around-heading
  // Headings should be surrounded by blank lines : https://github.com/DavidAnson/markdownlint/blob/main/doc/md022.md
  /*   "MD022": {
    // Include front matter content
    "include_front_matter": false,
    // Blank lines above heading
    "lines_above": 1,
    // Blank lines below heading
    "lines_below": 1,
  }, */
  // endregion

  // region MD023 heading-start-lef
  // Headings must start at the beginning of the line : https://github.com/DavidAnson/markdownlint/blob/main/doc/md023.md
  // "MD023": true,
  // endregion

  // region MD024 no-duplicate-headin
  // Multiple headings with the same content : https://github.com/DavidAnson/markdownlint/blob/main/doc/md024.md
  /*   "MD024": {
    // Only check sibling headings
    "siblings_only": false,
  }, */
  // endregion

  // region MD025 single-title/single-h
  // Multiple top-level headings in the same document : https://github.com/DavidAnson/markdownlint/blob/main/doc/md025.md
  /*   "MD025": {
    // RegExp for matching title in front matter
    "front_matter_title": "^\\s*title\\s*[:=]",
    // Heading level
    "level": 1,
  }, */
  // endregion

  // region MD026 no-trailing-punctuatio
  // Trailing punctuation in heading : https://github.com/DavidAnson/markdownlint/blob/main/doc/md026.md
  /*   "MD026": {
    // Punctuation characters
    "punctuation": ".,;:!。，；：！",
  }, */
  // endregion

  // region MD027 no-multiple-space-blockquot
  // Multiple spaces after blockquote symbol : https://github.com/DavidAnson/markdownlint/blob/main/doc/md027.md
  /*   "MD027": {
    // Include list items
    "list_items": true,
  }, */
  // endregion

  // region MD028 no-blanks-blockquot
  // Blank line inside blockquote : https://github.com/DavidAnson/markdownlint/blob/main/doc/md028.md
  // "MD028": true,
  // endregion

  // region MD029 ol-prefi
  // Ordered list item prefix : https://github.com/DavidAnson/markdownlint/blob/main/doc/md029.md
  /*   "MD029": {
    // List style
    "style": "one_or_ordered",
  }, */
  // endregion

  // region MD030 list-marker-spac
  // Spaces after list markers : https://github.com/DavidAnson/markdownlint/blob/main/doc/md030.md
  /*   "MD030": {
    // Spaces for single-line unordered list items
    "ul_single": 1,
    // Spaces for single-line ordered list items
    "ol_single": 1,
    // Spaces for multi-line unordered list items
    "ul_multi": 1,
    // Spaces for multi-line ordered list items
    "ol_multi": 1,
  }, */
  // endregion

  // region MD031 blanks-around-fence
  // Fenced code blocks should be surrounded by blank lines : https://github.com/DavidAnson/markdownlint/blob/main/doc/md031.md
  /*   "MD031": {
    // Include list items
    "list_items": true,
  }, */
  // endregion

  // region MD032 blanks-around-list
  // Lists should be surrounded by blank lines : https://github.com/DavidAnson/markdownlint/blob/main/doc/md032.md
  // "MD032": true,
  // endregion

  // region MD033 no-inline-htm
  // Inline HTML : https://github.com/DavidAnson/markdownlint/blob/main/doc/md033.md
  "MD033": {
    // Allowed elements
    "allowed_elements": ["details", "summary"],
    // Allowed elements in tables
    "table_allowed_elements": [],
  },
  // endregion

  // region MD034 no-bare-url
  // Bare URL used : https://github.com/DavidAnson/markdownlint/blob/main/doc/md034.md
  // "MD034": true,
  // endregion

  // region MD035 hr-style
  // Horizontal rule style : https://github.com/DavidAnson/markdownlint/blob/main/doc/md035.md
  "MD035": {
    // Horizontal rule style
    "style": "---",
  },
  // endregion

  // region MD036 no-emphasis-as-headin
  // Emphasis used instead of a heading : https://github.com/DavidAnson/markdownlint/blob/main/doc/md036.md
  /*   "MD036": {
    // Punctuation characters
    "punctuation": ".,;:!?。，；：！？",
  }, */
  // endregion

  // region MD037 no-space-in-emphasi
  // Spaces inside emphasis markers : https://github.com/DavidAnson/markdownlint/blob/main/doc/md037.md
  // "MD037": true,
  // endregion

  // region MD038 no-space-in-cod
  // Spaces inside code span elements : https://github.com/DavidAnson/markdownlint/blob/main/doc/md038.md
  // "MD038": true,
  // endregion

  // region MD039 no-space-in-link
  // Spaces inside link text : https://github.com/DavidAnson/markdownlint/blob/main/doc/md039.md
  // "MD039": true,
  // endregion

  // region MD040 fenced-code-languag
  // Fenced code blocks should have a language specified : https://github.com/DavidAnson/markdownlint/blob/main/doc/md040.md
  /*   "MD040": {
    // List of languages
    "allowed_languages": [],
    // Require language only
    "language_only": false,
  }, */
  // endregion

  // region MD041 first-line-heading/first-line-h
  // First line in a file should be a top-level heading : https://github.com/DavidAnson/markdownlint/blob/main/doc/md041.md
  /*   "MD041": {
    // Allow content before first heading
    "allow_preamble": false,
    // RegExp for matching title in front matter
    "front_matter_title": "^\\s*title\\s*[:=]",
    // Heading level
    "level": 1,
  }, */
  // endregion

  // region MD042 no-empty-link
  // No empty links : https://github.com/DavidAnson/markdownlint/blob/main/doc/md042.md
  // "MD042": true,
  // endregion

  // region MD043 required-heading
  // Required heading structure : https://github.com/DavidAnson/markdownlint/blob/main/doc/md043.md
  "MD043": {
    // List of headings
    "headings": [
      "# ?",
      "*",
      "## ?",
      "*",
      "### ?",
      "*",
      "#### ?",
      "*",
      "##### ?",
      "*",
      "###### ?",
    ],
    // Match case of headings
    "match_case": false,
  },
  // endregion

  // region MD044 proper-name
  // Proper names should have the correct capitalization : https://github.com/DavidAnson/markdownlint/blob/main/doc/md044.md
  /*   "MD044": {
    // List of proper names
    "names": [],
    // Include code blocks
    "code_blocks": true,
    // Include HTML elements
    "html_elements": true,
  }, */
  // endregion

  // region MD045 no-alt-tex
  // Images should have alternate text (alt text) : https://github.com/DavidAnson/markdownlint/blob/main/doc/md045.md
  // "MD045": true,
  // endregion

  // region MD046 code-block-styl
  // Code block style : https://github.com/DavidAnson/markdownlint/blob/main/doc/md046.md
  "MD046": {
    // Block style
    "style": "fenced",
  },
  // endregion

  // region MD047 single-trailing-newlin
  // Files should end with a single newline character : https://github.com/DavidAnson/markdownlint/blob/main/doc/md047.md
  // "MD047": true,
  // endregion

  // region MD048 code-fence-styl
  // Code fence style : https://github.com/DavidAnson/markdownlint/blob/main/doc/md048.md
  /*   "MD048": {
    // Code fence style
    "style": "consistent",
  }, */
  // endregion

  // region MD049 emphasis-styl
  // Emphasis style : https://github.com/DavidAnson/markdownlint/blob/main/doc/md049.md
  /*   "MD049": {
    // Emphasis style
    "style": "consistent",
  }, */
  // endregion

  // region MD050 strong-styl
  // Strong style : https://github.com/DavidAnson/markdownlint/blob/main/doc/md050.md
  /*   "MD050": {
    // Strong style
    "style": "consistent",
  }, */
  // endregion

  // region MD051 link-fragment
  // Link fragments should be valid : https://github.com/DavidAnson/markdownlint/blob/main/doc/md051.md
  /*   "MD051": {
    // Ignore case of fragments
    "ignore_case": false,
    // Pattern for ignoring additional fragments
    "ignored_pattern": "",
  }, */
  // endregion

  // region MD052 reference-links-image
  // Reference links and images should use a label that is defined : https://github.com/DavidAnson/markdownlint/blob/main/doc/md052.md
  /*   "MD052": {
    // Ignored link labels
    "ignored_labels": ["x"],
    // Include shortcut syntax
    "shortcut_syntax": false,
  }, */
  // endregion

  // region MD053 link-image-reference-definition
  // Link and image reference definitions should be needed : https://github.com/DavidAnson/markdownlint/blob/main/doc/md053.md
  /*   "MD053": {
    // Ignored definitions
    "ignored_definitions": ["//"],
  }, */
  // endregion

  // region MD054 link-image-styl
  // Link and image style : https://github.com/DavidAnson/markdownlint/blob/main/doc/md054.md
  /*   "MD054": {
    // Allow autolinks
    "autolink": true,
    // Allow inline links and images
    "inline": true,
    // Allow full reference links and images
    "full": true,
    // Allow collapsed reference links and images
    "collapsed": true,
    // Allow shortcut reference links and images
    "shortcut": true,
    // Allow URLs as inline links
    "url_inline": true,
  }, */
  // endregion

  // region MD055 table-pipe-styl
  // Table pipe style : https://github.com/DavidAnson/markdownlint/blob/main/doc/md055.md
  /*   "MD055": {
    // Table pipe style
    "style": "consistent",
  }, */
  // endregion

  // region MD056 table-column-coun
  // Table column count : https://github.com/DavidAnson/markdownlint/blob/main/doc/md056.md
  // "MD056": true,
  // endregion

  // region MD058 blanks-around-table
  // Tables should be surrounded by blank lines : https://github.com/DavidAnson/markdownlint/blob/main/doc/md058.md
  // "MD058": true,
  // endregion

  // region MD059 descriptive-link-tex
  // Link text should be descriptive : https://github.com/DavidAnson/markdownlint/blob/main/doc/md059.md
  /*   "MD059": {
    // Prohibited link texts
    "prohibited_texts": ["click here", "here", "link", "more"],
  }, */
  // endregion

  // region MD060 table-column-styl
  // Table column style : https://github.com/DavidAnson/markdownlint/blob/main/doc/md060.md
  "MD060": {
    // Table column style
    "style": "compact",
    // Aligned delimiter columns
    "aligned_delimiter": false,
  },
  // endregion
}
