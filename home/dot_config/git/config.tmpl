# See https://git-scm.com/docs/git-config

[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
[init]
	defaultBranch = master
[pull]
	rebase = true 			 # Rebase (instead of merge) on pull
[push]
	autoSetupRemote = true   # Automatically set upstream branch on push
[diff]
	algorithm = histogram    # Clearer diffs on moved/edited lines
	colorMoved = plain       # Highlight moved blocks in diffs
	mnemonicPrefix = true    # More intuitive refs in diff output
[commit]
	verbose = true           # Include diff comment in commit message template
	gpgsign = true
[column]
	ui = auto 			     # Output in columns when possible
[branch]
	sort = -committerdate    # Sort branches by most recent commit first
[tag]
	sort = -version:refname  # Sort version numbers as you would expect
[rerere]
	enabled = true           # Record and reuse conflict resolutions
	autoupdate = true        # Apply stored conflict resolutions automatically

[user]
	name = {{ .github.name}}
	email = {{ .github.email }}
	signingkey = key::{{ (bitwarden "item" "GithubSigningKey").sshKey.publicKey }}

[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = {{ .chezmoi.homeDir }}/.ssh/allowed_signers

[url "git@github.com:"]
  insteadOf = https://github.com/
[credential "https://github.com"]
	helper =
	helper = !gh auth setup-git
[credential "https://api.github.com"]
	helper =
	helper = !gh auth setup-git
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth setup-git
	# helper = !gh auth git-credential

[hook "hk-commit-msg"]
	command = test \"${HK:-1}\" = \"0\" || /usr/bin/mise x hk -- hk run commit-msg --from-hook
	event = commit-msg
[hook "hk-pre-commit"]
	command = test \"${HK:-1}\" = \"0\" || /usr/bin/mise x hk -- hk run pre-commit --from-hook --staged
	event = pre-commit
[hook "hk-pre-push"]
	command = test \"${HK:-1}\" = \"0\" || /usr/bin/mise x hk -- hk run pre-push --from-hook
	event = pre-push
[hook "hk-prepare-commit-msg"]
	command = test \"${HK:-1}\" = \"0\" || /usr/bin/mise x hk -- hk run prepare-commit-msg --from-hook
	event = prepare-commit-msg

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    hyperlinks = true
    hyperlinks-file-link-format = "vscode://file/{path}:{line}"
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection

[merge]
    conflictStyle = zdiff3
