{
  "version": 1,
  "idle": { "lock": 300, "screensaver": 150 },
  "bar": {
    "id": "omarchy.bar",
    "background": "glassy",
    "test": "",
    "centerAnchor": "promaa.clock",
    "layout": {
      "left": [
        { "id": "omarchy.menu" },
        {
          "id": "tornikegomareli.spaces",
          "activeIcon": "",
          "activeStyle": "accent",
          "animations": false,
          "density": "compact",
          "dimUnfocused": true,
          "focusedTitle": false,
          "groupApps": true,
          "labelStyle": "number",
          "persistentWorkspaces": 6,
          "pillBackground": true,
          "pillHeight": 0,
          "pillPadding": 0,
          "previewLive": false,
          "previewSize": "small",
          "scrollSwitch": false,
          "showApps": "all",
          "tooltips": false,
          "wsIcon1": "",
          "wsIcon2": "",
          "wsIcon3": "",
          "hideEmpty": true,
          "perMonitor": true,
          "holdSuperNumbers": false
        }
      ],
      "center": [
        { "alwaysShow": true, "id": "omarchy.indicators" },
        { "id": "omarchy.weather" },
        {
          "enableMeetingLinks": false,
          "format": "dddd @ d MMMM HH:mm ('v'ww)",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "promaa.clock",
          "notifyMinutesBefore": 5,
          "notifyUpcomingEvents": true,
          "syncIntervalMinutes": 3600,
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "captureOverflow": true,
          "icons": {},
          "id": "so.den",
          "widgets": [
            "omarchy.audio",
            "omarchy.bluetooth",
            "omarchy.indicators",
            "omarchy.keyboard-layout",
            "omarchy.monitor",
            "omarchy.network",
            "omarchy.power",
            "yoyo.system-tidy"
          ]
        },
        {
          "confirmDelete": false,
          "confirmTrash": false,
          "editor": "code",
          "editorChoice": "omarchy",
          "glyph": "󰙅",
          "id": "xyzlab.omafile",
          "rememberFolderViews": true,
          "showHidden": true,
          "sortDirsFirst": true,
          "useTrash": true,
          "windowMode": "popup"
        },
        {
          "id": "io.github.davidgudovic.omalint",
          "refreshIntervalSec": 3600
        },
        {
          "checkSeconds": 3600,
          "id": "io.github.dadofsambonzuki.chezmoi-hound",
          "whenClean": "Hide"
        },
        { "id": "omarchy.system-update" }
      ],
      "right": [
        { "id": "hass" },
        {
          "id": "io.github.juancasanueva.plugin-manager",
          "allowUnverifiedInstalls": true,
          "allowUnverifiedUpdates": true,
          "openAs": "window",
          "watching": [
            "ac.control-panel",
            "akitaonrails.ai-usagebar",
            "alessandrobelli.pomodoro",
            "andreconde.cockpit",
            "bibek.obsidian-search",
            "blackcode.omacolorbar",
            "chyld.mise-radar",
            "cj.focus-garden",
            "crmne.hyprmoncfg",
            "cynricantao.system-monitor",
            "dansmith888.synology-drive",
            "evindor.keystroke",
            "filipharald.oma-mise",
            "firstpick.skill-manager",
            "ggregoro.quick-reference",
            "gregl83.plancks",
            "hass",
            "io.github.bitshiftxr.atrium",
            "io.github.charlie0113-t.omarchy-nas",
            "io.github.dadofsambonzuki.chezmoi-hound",
            "io.github.davidgudovic.omalint",
            "io.github.dubearte.scratchpad",
            "io.github.fatihaydost.houra",
            "io.github.ferc10110.runbook",
            "io.github.juancasanueva.plugin-manager",
            "io.github.maajix.spotlight",
            "io.github.mattwolfgang.clock",
            "io.github.nobledoodle.omarchroma",
            "io.github.sersah.study-tracker",
            "io.github.sirjul1337.lock-explorer",
            "io.github.tug-benson.synology-drive",
            "io.github.weedwhitesandwine.obsiduous",
            "liambeck99.update-center",
            "luca.obsidian-daily",
            "mateus.omaplug",
            "oliwier.agent-skills-manager",
            "omarchy.notifications",
            "othavi0.agent-bar",
            "paudelsamir.newsdash",
            "promaa.clock",
            "rosakodu.dock",
            "taskwarrior-time",
            "tiertek.ytm",
            "tornikegomareli.spaces",
            "traymd-omarchy",
            "typecraft.omacast",
            "tyrsolution.app-launcher",
            "xyzlab.omafile",
            "xyzlab.pigeon",
            "yoyo.system-tidy",
            "ubruckhaus.ai-agents-map"
          ]
        },
        {
          "colorCodeUsage": true,
          "hiddenBarEntries": ["anthropic", "zai"],
          "hiddenMetrics": { "copilot": ["Premium requests"] },
          "id": "akitaonrails.ai-usagebar",
          "lastSelectedEntryId": "openai",
          "showAll": true,
          "showAntigravityClaudeGpt": true,
          "showAntigravityGemini": true,
          "showProvider": false,
          "showValue": false
        },
        {
          "glyph": "󰍢",
          "id": "xyzlab.pigeon",
          "topics": "Skuggsidan,Skuggsidan-alerts"
        },
        { "id": "omarchy.tailscale" }
      ],
      "tray": []
    }
  },
  "dock": {
    "pinned": ["xyzlab.omafile", "google-chrome", "foot", "omawrite"],
    "position": "bottom"
  },
  "plugins": [
    { "id": "akitaonrails.ai-usagebar" },
    { "id": "io.github.dadofsambonzuki.chezmoi-hound" },
    { "id": "io.github.davidgudovic.omalint" },
    { "id": "io.github.juancasanueva.plugin-manager" },
    { "id": "promaa.clock" },
    { "id": "so.den" },
    { "id": "tornikegomareli.spaces" },
    { "id": "xyzlab.omafile" },
    { "id": "xyzlab.pigeon" },
    { "id": "yoyo.system-tidy" },
    { "id": "omarchy.audio" },
    { "id": "omarchy.bluetooth" },
    { "id": "omarchy.keyboard-layout" },
    { "id": "omarchy.monitor" },
    { "id": "omarchy.network" },
    { "id": "omarchy.power" }
  ],
  "disabledPlugins": [
    { "id": "omarchy.active-window" },
    { "id": "omarchy.agents" },
    { "id": "omarchy.clock" },
    { "id": "omarchy.dropbox" },
    { "id": "omarchy.elsewhen" },
    { "id": "omarchy.media" },
    { "id": "omarchy.microphone" },
    { "id": "omarchy.nightlight" },
    { "id": "omarchy.speedtest" },
    { "id": "omarchy.workspaces" },
    {
      "hidden": ["chrome_status_icon_1"],
      "id": "omarchy.tray",
      "pinned": []
    }
  ]
