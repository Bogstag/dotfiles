{
  "version": 1,
  "idle": { "lock": 300, "screensaver": 150 },
  "position": "top",
  "transparent": false,
  "bar": {
    "id": "omarchy.bar",
    "centerAnchor": "promaa.clock",
    "layout": {
      "left": [
        { "id": "omarchy.menu" },
        {
          "id": "tornikegomareli.spaces",
          "activeIcon": "",
          "activeStyle": "accent",
          "animations": false,
          "density": "compact",
          "dimUnfocused": true,
          "focusedTitle": false,
          "groupApps": true,
          "labelStyle": "custom",
          "persistentWorkspaces": 6,
          "pillBackground": true,
          "pillHeight": 0,
          "pillPadding": 0,
          "previewLive": false,
          "previewSize": "small",
          "scrollSwitch": false,
          "showApps": "all",
          "tooltips": false,
          "wsIcon1": "",
          "wsIcon2": "",
          "wsIcon3": ""
        }
      ],
      "center": [
        { "id": "omarchy.indicators", "alwaysShow": true },
        { "id": "omarchy.weather" },
        {
          "id": "promaa.clock",
          "enableMeetingLinks": false,
          "format": "dddd @ d MMMM HH:mm ('v'ww)",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "notifyMinutesBefore": 5,
          "notifyUpcomingEvents": true,
          "syncIntervalMinutes": 3600,
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "xyzlab.omafile",
          "confirmTrash": false,
          "confirmDelete": false,
          "editor": "code",
          "editorChoice": "omarchy",
          "glyph": "󰙅",
          "rememberFolderViews": true,
          "showHidden": true,
          "windowMode": "popup",
          "sortDirsFirst": true,
          "useTrash": true
        },
        {
          "id": "io.github.juancasanueva.plugin-manager",
          "openAs": "overlay",
          "allowUnverifiedUpdates": true,
          "allowUnverifiedInstalls": true,
          "watching": [
            "akitaonrails.ai-usagebar",
