{
  // Extends the Quickshell Omarchy menu with JSONC.
  // Extends: file:///usr/share/omarchy/default/omarchy/omarchy-menu.jsonc
  // Fields:
  //   icon        Nerd Font glyph shown in the icon column.
  //   label       Visible row title.
  //   action      Shell command to run. If omitted, the row is a submenu.
  //   target      Existing submenu id to open. Use for links/aliases.
  //   provider    Runtime provider function/command returning JSON rows. Only use provider when a provider_name function or command named "name" returns JSON rows.
  //   aliases     alternate `omarchy menu summon <name>` routes; also searchable.
  //   description Optional subtitle and extra search text.
  //   when        Shell condition; hide row when it fails.
  //   checked     Shell condition; append ✓ when it succeeds.
  //
  // Examples:
  // "personal": {"icon":"","label":"Personal"}, # Top menu
  // "personal.notes": {"icon":"󰎞","label":"Notes","action":"omarchy-launch-editor ~/notes"},
  // "personal.files": {"icon":"","label":"Files","action":"uwsm-app -- nautilus ~/Documents"},
  // "about": {"icon":"","label":"About","action":"omarchy-launch-or-focus-tui \"zsh -c 'fastfetch; read -k 1'\""}, # Replace the default About
  //
  "Skuggsidan": { "icon": "", "label": "Skuggsidan" },
  "Skuggsidan.devdocs": {
    "icon": "",
    "label": "Dev Docs",
    "action": "omarchy launch webapp https://devdocs.io/"
  },
  "Skuggsidan.keyhint": {
    "icon": "󰌌",
    "label": "KeyHint",
    "action": "keyhint"
  },
  "style.lockscreen": {
    "icon": "󰌾",
    "label": "Lock Screen",
    "aliases": ["lockscreen", "lock-screen"],
    "description": "Preview and choose a lock screen design",
    "action": "omarchy-shell lock explore"
  }
}
