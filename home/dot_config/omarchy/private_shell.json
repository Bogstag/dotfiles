{
  "version": 1,
  "idle": { "lock": 300, "screensaver": 150 },
  "bar": {
    "id": "omarchy.bar",
    "position": "top",
    "transparent": false,
    "centerAnchor": "promaa.clock",
    "layout": {
      "left": [
        { "id": "omarchy.menu" },
        { "id": "omarchy.workspaces" },
        { "id": "omarchy.spacer" }
      ],
      "center": [
        { "id": "omarchy.indicators" },
        { "id": "omarchy.weather" },
        { "id": "io.github.davidgudovic.omalint" },
        {
          "id": "promaa.clock",
          "enableMeetingLinks": false,
          "format": "dddd @ d MMMM HH:mm ('v'ww)",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "notifyMinutesBefore": 5,
          "notifyUpcomingEvents": true,
          "syncIntervalMinutes": 60,
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "io.github.juancasanueva.plugin-manager",
          "openAs": "window",
          "watching": [
            "chyld.mise-radar",
            "filipharald.oma-mise",
            "firstpick.skill-manager",
            "io.github.davidgudovic.omalint",
            "io.github.ferc10110.runbook",
            "io.github.iainfreestone.toolroll",
            "oliwier.agent-skills-manager",
            "raavail.mise-manager"
          ]
        },
        { "id": "yoyo.system-tidy" },
        { "id": "raavail.mise-manager" },
        { "id": "omarchy.system-update" }
      ],
      "right": [
        { "id": "omarchy.spacer" },
        {
          "id": "omarchy.tray",
          "hidden": [],
          "pinned": ["chrome_status_icon_1"]
        },
        {
          "id": "io.github.dadofsambonzuki.chezmoi-hound",
          "checkSeconds": 3000,
          "whenClean": "Show"
        },
        {
          "id": "akitaonrails.ai-usagebar",
          "lastSelectedEntryId": "openai",
          "showAll": true,
          "showProvider": false,
          "showValue": false
        },
        { "id": "omarchy.tailscale" },
        { "id": "omarchy.keyboard-layout" },
        { "id": "omarchy.bluetooth" },
        { "id": "omarchy.network" },
        { "id": "omarchy.audio" },
        { "id": "omarchy.monitor" },
        { "id": "omarchy.power" }
      ]
    }
  },
  "disabledPlugins": [
    { "id": "omarchy.active-window" },
    { "id": "omarchy.agents" },
    { "id": "omarchy.clock" },
    { "id": "omarchy.dropbox" },
    { "id": "omarchy.media" },
    { "id": "omarchy.microphone" },
    { "id": "omarchy.nightlight" }
  ],
  "plugins": [
    { "id": "akitaonrails.ai-usagebar" },
    { "id": "io.github.dadofsambonzuki.chezmoi-hound" },
    { "id": "io.github.juancasanueva.plugin-manager" },
    { "id": "omarchy.lock" },
    { "id": "omarchy.notifications" },
    { "id": "promaa.clock" },
    { "id": "yoyo.system-tidy" }
  ]
}
