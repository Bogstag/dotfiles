{
  "bar": {
    "centerAnchor": "promaa.clock",
    "layout": {
      "center": [
        { "id": "omarchy.indicators" },
        {
          "alwaysShow": true,
          "displayMode": "all",
          "fullscreenOverlay": "steam",
          "id": "njpatel.omapager",
          "showCountdown": true
        },
        {
          "enableMeetingLinks": false,
          "format": "dddd @ d MMMM HH:mm ('v'ww)",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "promaa.clock",
          "notifyMinutesBefore": 5,
          "notifyUpcomingEvents": true,
          "syncIntervalMinutes": 60,
          "verticalFormat": "HH\n—\nmm"
        },
        { "id": "omarchy.weather" },
        { "id": "io.github.momostifler96.omarchy-cleaner" },
        {
          "id": "io.github.twiking.omacontrol",
          "showActiveSwitchCount": false,
          "showBatteryWarnings": false,
          "showNetworkWarning": false
        },
        { "id": "yoyo.system-tidy" },
        {
          "id": "io.github.juancasanueva.plugin-manager",
          "openAs": "overlay"
        },
        { "id": "omarchy.system-update" }
      ],
      "left": [
        { "id": "omarchy.menu" },
        {
          "activeStyle": "accent",
          "density": "roomy",
          "dimUnfocused": true,
          "focusedTitle": false,
          "groupApps": true,
          "hideEmpty": false,
          "iconSize": 16,
          "iconStyle": "color",
          "id": "tornikegomareli.spaces",
          "labelStyle": "number",
          "perMonitor": false,
          "persistentWorkspaces": 6,
          "pillBackground": true,
          "previews": false,
          "previewSize": "small",
          "showApps": "all",
          "tooltips": true
        },
        { "id": "bjarneo.workspace-layout" },
        {
          "id": "io.github.sirjul1337.lock-explorer",
          "boot": "snapshot:editorial",
          "openAs": "full"
        }
      ],
      "right": [
        {
          "hidden": [],
          "id": "omarchy.tray",
          "pinned": ["chrome_status_icon_1"]
        },
        { "id": "omarchy.spacer" },
        {
          "checkSeconds": 3000,
          "id": "io.github.dadofsambonzuki.chezmoi-hound",
          "whenClean": "Show"
        },
        { "id": "omarchy.spacer" },
        {
          "id": "akitaonrails.ai-usagebar",
          "lastSelectedEntryId": "openai",
          "showAll": true,
          "showProvider": false,
          "showValue": false
        },
        { "id": "omarchy.spacer" },
        { "id": "omarchy.tailscale" },
        { "id": "omarchy.keyboard-layout" },
        { "id": "omarchy.bluetooth" },
        { "id": "omarchy.network" },
        { "id": "omarchy.audio" },
        { "id": "omarchy.monitor" },
        { "id": "omarchy.power" }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "disabledPlugins": [
    "omarchy.active-window",
    "omarchy.agents",
    "omarchy.clock",
    "omarchy.dropbox",
    "omarchy.lock",
    "omarchy.media",
    "omarchy.microphone",
    "omarchy.nightlight",
    "omarchy.notifications",
    "omarchy.workspaces"
  ],
  "idle": { "lock": 300, "screensaver": 150 },
  "plugins": [
    "akitaonrails.ai-usagebar",
    "bjarneo.workspace-layout",
    "io.github.dadofsambonzuki.chezmoi-hound",
    "io.github.juancasanueva.plugin-manager",
    "io.github.momostifler96.omarchy-cleaner",
    "io.github.sirjul1337.lock-explorer",
    "io.github.twiking.omacontrol",
    "njpatel.omapager",
    "promaa.clock",
    "tornikegomareli.spaces",
    "yoyo.system-tidy"
  ],
  "version": 1
}
