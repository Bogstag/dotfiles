{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "tornikegomareli.spaces",
          "showApps": "all",
          "groupApps": false,
          "dimUnfocused": true,
          "activeStyle": "accent",
          "pillBackground": true,
          "labelStyle": "number",
          "density": "roomy",
          "previewSize": "small"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "promaa.clock",
          "format": "dddd @ d MMMM HH:mm ('v'ww)",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm",
          "syncIntervalMinutes": 60,
          "enableMeetingLinks": false
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.spacer"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray",
          "pinned": [
            "chrome_status_icon_1"
          ],
          "hidden": []
        },
        {
          "id": "omarchy.spacer"
        },
        {
          "id": "io.github.dadofsambonzuki.chezmoi-hound",
          "whenClean": "Show"
        },
        {
          "id": "omarchy.spacer"
        },
        {
          "id": "akitaonrails.ai-usagebar",
          "lastSelectedEntryId": "openai",
          "showAll": true,
          "showProvider": false,
          "showValue": false
        },
        {
          "id": "omarchy.spacer"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "omarchy.tray"
    },
    {
      "id": "omarchy.tailscale"
    },
    {
      "id": "akitaonrails.ai-usagebar"
    },
    {
      "id": "io.github.dadofsambonzuki.chezmoi-hound"
    }
  ]
}
