{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "promaa.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "tornikegomareli.spaces",
          "activeStyle": "accent",
          "density": "roomy",
          "dimUnfocused": true,
          "groupApps": true,
          "hideEmpty": false,
          "iconSize": 16,
          "labelStyle": "number",
          "pillBackground": true,
          "previewSize": "small",
          "previews": false,
          "showApps": "all",
          "perMonitor": false,
          "persistentWorkspaces": 6,
          "focusedTitle": false,
          "tooltips": true,
          "iconStyle": "color"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "njpatel.omapager",
          "alwaysShow": true,
          "displayMode": "all",
          "showCountdown": true,
          "fullscreenOverlay": "steam"
        },
        {
          "id": "promaa.clock",
          "enableMeetingLinks": false,
          "format": "dddd @ d MMMM HH:mm ('v'ww)",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "syncIntervalMinutes": 60,
          "verticalFormat": "HH\n—\nmm",
          "notifyUpcomingEvents": true,
          "notifyMinutesBefore": 5
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "io.github.twiking.omacontrol",
          "showActiveSwitchCount": false,
          "showNetworkWarning": false,
          "showBatteryWarnings": false
        },
        {
          "id": "yoyo.system-tidy"
        },
        {
          "id": "io.github.juancasanueva.plugin-manager",
          "openAs": "overlay"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray",
          "pinned": ["chrome_status_icon_1"],
          "hidden": []
        },
        {
          "id": "omarchy.spacer"
        },
        {
          "id": "io.github.dadofsambonzuki.chezmoi-hound",
          "whenClean": "Show",
          "checkSeconds": 3000
        },
        {
          "id": "omarchy.spacer"
        },
        {
          "id": "akitaonrails.ai-usagebar",
          "lastSelectedEntryId": "openai",
          "showAll": true,
          "showProvider": false,
          "showValue": false
        },
        {
          "id": "omarchy.spacer"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "tornikegomareli.spaces"
    },
    {
      "id": "promaa.clock"
    },
    {
      "id": "io.github.dadofsambonzuki.chezmoi-hound"
    },
    {
      "id": "akitaonrails.ai-usagebar"
    },
    {
      "id": "njpatel.omapager"
    },
    {
      "id": "io.github.juancasanueva.plugin-manager"
    },
    {
      "id": "yoyo.system-tidy"
    },
    {
      "id": "io.github.sirjul1337.lock-explorer"
    },
    {
      "id": "io.github.twiking.omacontrol"
    }
  ],
  "disabledPlugins": [
    {
      "id": "omarchy.active-window"
    },
    {
      "id": "omarchy.agents"
    },
    {
      "id": "omarchy.clock"
    },
    {
      "id": "omarchy.dropbox"
    },
    {
      "id": "omarchy.media"
    },
    {
      "id": "omarchy.microphone"
    },
    {
      "id": "omarchy.nightlight"
    },
    {
      "id": "omarchy.notifications"
    },
    {
      "id": "omarchy.workspaces"
    },
    {
      "id": "omarchy.lock"
    }
  ],
  "cloneSourceRestores": ["io.github.sirjul1337.lock-explorer"]
}
