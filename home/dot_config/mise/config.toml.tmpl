#:schema https://mise.jdx.dev/schema/mise.json

[task_config]
includes = ["tasks.toml"]

[env]
GITHUB_TOKEN = '{{ "{{" }}exec(command="gh auth token 2>/dev/null || true"){{ "}}" }}'
BW_SESSION = '{{ "{{" }}exec(command="sh -c \"cat ${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bw_session 2>/dev/null || true\""){{ "}}" }}'


[settings]
upgrade.auto_prune = false
experimental = true
color_theme = "catppuccin"

[settings.skills]
dir = ".agents/skills"
auto_sync = true
prune = true

[tools]
"github:daptify14/chezit" = { version = "latest", os = ["linux"] }
"npm:@kitlangton/ghui" = "latest"
"packslip:github.com/jdx/hk" = "latest"
codex = "latest"
copilot = "latest"
gemini = { version = "latest", allow_builds = ["@github/keytar", "node-pty"] }
gh = "latest"
node = "26.7.0"
opencode = "latest"
yazi = "latest"
