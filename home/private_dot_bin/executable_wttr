    if [[ "${usage_z:-false}" = "true" ]]; then format=+"%z"; fi
    if [[ "${usage_Z:-false}" = "true" ]]; then format=+"%Z"; fi
    curl v3.wttr.in?format="${format}"
    exit 0
fi

# If you source this file, it will set WTTR_PARAMS as well as show weather.
# WTTR_PARAMS, "F q m" behaves the same as "Fqm".
if [[ -z "$WTTR_PARAMS" ]]; then
  # Form localized URL parameters for curl
  if [[ -t 1 ]] && [[ "$(tput cols)" -lt 125 ]]; then
      WTTR_PARAMS+='n' # narrow version (only day and night)
  fi 2> /dev/null
  for _token in $( locale LC_MEASUREMENT ); do
    case $_token in
      1) WTTR_PARAMS+='m' ;;  # metric (SI) (used by default everywhere except US)
      2) WTTR_PARAMS+='u' ;;  # USCS (used by default in US)
      *) WTTR_PARAMS+='m' ;;  # default metric (SI)
    esac
  done 2> /dev/null
  unset _token
  export WTTR_PARAMS
fi

wttr() {
  local location="${1// /+}"
  test "$#" -gt 0 && shift
  local args=()
  for p in $WTTR_PARAMS "$@"; do
    args+=("--data-urlencode" "$p")
  done
  curl -fGsS -H "Accept-Language: ${LANG%_*}" "${args[@]}" --compressed "wttr.in/${location}"?lang=sv
}

wttr "$@"


