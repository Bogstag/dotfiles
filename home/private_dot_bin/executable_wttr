fi


if [[ "${usage_format:-false}" = "true" ]]; then
    format=""
    if [[ "${usage_y:-false}" = "true" ]]; then format=+"%y"; fi
    if [[ "${usage_i:-false}" = "true" ]]; then format=+"%i"; fi
    if [[ "${usage_c:-false}" = "true" ]]; then format=+"%c"; fi
