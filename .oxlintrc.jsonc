{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  // file:///home/bogge/.oxlintrc.jsonc
  "extends": ["../../../.oxlintrc.jsonc"],
  // "plugins": ["eslint", "typescript", "unicorn", "oxc"], // Default
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error"
  },
  "rules": {
    "sort-imports": "allow",
    "sort-keys": [
      "allow",
      "asc",
      {
        "allowLineSeparatedGroups": true,
        "caseSensitive": true,
        "minKeys": 2,
        "natural": true
      }
    ],
    "sort-vars": "allow"
  }
}
