{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "pedantic": "warn",
    "perf": "warn",
    "restriction": "warn",
    "style": "warn",
    "suspicious": "warn"
  },
  "env": { "builtin": true, "esnext": true },
  "ignorePatterns": [
    "*.min.js",
    "coverage/**",
    "dist/**",
    "test/snapshots/**",
    "vendor/**"
  ],
  "options": {
    "reportUnusedDisableDirectives": "error",
    "typeAware": true,
    "typeCheck": true
  },
  "overrides": [{ "files": ["**/*.test.mjs", "cli/*.ts", "utils/*.ts"] }],
  "plugins": ["eslint", "import", "node", "oxc", "typescript", "vitest"],
  "rules": {
    "eslint/func-style": ["error", "declaration"],
    "eslint/no-console": ["warn", { "allow": ["info", "error"] }],
    "eslint/one-var": "allow",
    "eslint/sort-imports": ["allow", { "allowSeparatedGroups": true }],
    "import/no-named-export": "off",
    "import/no-nodejs-modules": [
      "error",
      {
        "allow": [
          "node:assert/strict",
          "node:child_process",
          "node:fs",
          "node:fs/promises",
          "node:os",
          "node:path",
          "node:test"
        ]
      }
    ],
    "import/prefer-default-export": "off",
    "no-continue": "warn",
    "no-duplicate-imports": [
      "error",
      { "allowSeparateTypeImports": true }
    ],
    "node/no-sync": "allow",
    "node/no-top-level-await": "allow",
    "oxc/no-async-await": "allow",
    "oxc/no-optional-chaining": "off",
    "sort-imports": "allow",
    "sort-keys": [
      "error",
      "asc",
      { "caseSensitive": true, "minKeys": 2, "natural": false }
    ],
    "sort-vars": "error",
    "typescript/no-magic-numbers": [
      "error",
      {
        "ignoreArrayIndexes": true,
        "ignoreClassFieldInitialValues": true,
        "ignoreDefaultValues": true,
        "ignoreEnums": true
      }
    ],
    "typescript/prefer-readonly-parameter-types": "allow"
  }
}
