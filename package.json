{
  "name": "dotfiles",
  "version": "0.0.4",
  "private": true,
  "keywords": [
    "chezmoi",
    "dotfiles",
    "insanity",
    "madness",
    "mise",
    "omarchy",
    "vitepress"
  ],
  "author": "Bogstag",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bogstag/dotfiles.git"
  },
  "type": "module",
  "scripts": {
    "check:codespell": "codespell",
    "check:cspell": "cspell .",
    "check:jactionlint": "jactionlint",
    "check:oxfmt": "vp fmt --check",
    "check:oxlint": "vp lint",
    "check:typos": "typos .",
    "docs:build": "vitepress build .",
    "docs:dev": "vitepress dev .",
    "docs:preview": "vitepress preview .",
    "fix:codespell": "codespell --write-changes",
    "fix:jactionlint": "jactionlint --fix",
    "fix:oxfmt": "vp fmt",
    "fix:oxlint": "vp lint --fix",
    "fix:typos": "typos --write-changes .",
    "knip": "knip",
    "oxlint:danger": "vp lint --fix-dangerously",
    "oxlint:suggest": "vp lint --fix-suggestions"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "26.0.1",
    "@tsconfig/node-ts": "23.6.5",
    "@tsconfig/recommended": "1.0.14",
    "@types/node": "26.6.6",
    "codespell": "1.1.7",
    "cspell": "10.5.2",
    "knip": "6.47.0",
    "tsrs": "7.1.0-beta.tsrs4",
    "typescript": "7.0.2",
    "vite-plus": "1.7.0",
    "vitepress": "1.6.4",
    "vitepress-sidebar": "1.41.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.0.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=26",
    "npm": "^11.0.0"
  },
  "packageManager": "npm@11.20.0"
}
