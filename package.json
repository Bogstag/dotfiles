{
  "name": "dotfiles",
  "version": "0.0.4",
  "private": true,
  "keywords": [
    "chezmoi",
    "dotfiles",
    "insanity",
    "madness",
    "mise",
    "omarchy",
    "vitepress"
  ],
  "author": "Bogstag",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bogstag/dotfiles.git"
  },
  "type": "module",
  "scripts": {
    "docs:build": "vitepress build .",
    "docs:dev": "vitepress dev .",
    "docs:preview": "vitepress preview .",
    "knip": "knip",
    "vp:check": "vp check",
    "vp:danger": "vp check --fix-dangerously",
    "vp:fix": "vp check --fix"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "26.0.1",
    "@tsconfig/node-ts": "23.6.5",
    "@tsconfig/recommended": "1.0.14",
    "@types/node": "26.6.10",
    "knip": "6.48.0",
    "typescript": "7.0.2",
    "vite-plus": "1.8.0",
    "vitepress": "1.6.4",
    "vitepress-sidebar": "1.41.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.0.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=26",
    "npm": "^11.0.0"
  },
  "packageManager": "npm@11.20.0"
}
