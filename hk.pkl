amends "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Builtins.pkl"
// Using a coding agent? See https://hk.jdx.dev/agents

// defines what happens during git pre-commit hook
local linters = new Mapping<String, Step | Group> {
  ["pkl"] = Builtins.pkl
  ["pkl-format"] = Builtins.pkl_format

  // Shells
  ["shellcheck"] = (Builtins.shellcheck) {
    exclude = List("**/*.sh.tmpl")
  }
  ["shfmt"] = (Builtins.shfmt) {
    exclude = List("**/*.sh.tmpl")
  }
  ["shellharden"] = Builtins.shellharden

  ["newlines"] = Builtins.newlines
  ["trailing-whitespace"] = Builtins.trailing_whitespace

  ["tombi"] = Builtins.tombi
  ["mise"] = Builtins.mise
  // ["markdown-lint"] = Builtins.markdown_lint
  ["hk-test"] = Builtins.hk_test
  ["tombi-format"] = Builtins.tombi_format

  // Render
  ["render"] = new Step {
    check = "mise run render:*"
    output_summary = "hide"
  }
}

hooks = new {
  ["pre-commit"] {
    fix = true
    steps = new {
      ["prelint"] {
        check = "mise run prelint"
        exclusive = true
      }
      ...linters
      ["postlint"] {
        check = "echo postlint"
        exclusive = true
      }
    }
  }
  ["pre-push"] {
    steps = linters
  }
  ["check"] {
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
}

warnings = List("missing-profiles")
