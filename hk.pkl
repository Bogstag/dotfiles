amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"
// amends "/home/bogge/.config/hk/config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl"

// local config = "/home/bogge/.config/hk/config.pkl"

steps {
  ["trailing_whitespace"] = (Builtins.trailing_whitespace) {
  //    description = "Detect and remove trailing whitespace"
  }
  //

  ["newlines"] = (Builtins.newlines) {
  //    description = "Ensure files end with newline"
  }
  //

  ["check_shebang_scripts_are_executable"] = (Builtins.check_shebang_scripts_are_executable) {
    //  description = "Verify files with shebang lines are executable"
    //  Bash startup files are sourced; executable_ sets the target's executable mode.
    exclude =
      List(
        "**/*.ps1",
        "**/*.tmpl",
        "**/executable_*",
        "home/dot_bash_profile",
        "home/dot_bashrc.d/**",
      )
  }
  //

  ["pkl"] = Builtins.pkl // description = "Pkl configuration language"
  //

  ["pkl_format"] = (Builtins.pkl_format) {
  //    description = "Pkl formatter"
  }
  //

  ["tombi"] = (Builtins.tombi) {
    //  description = "TOML linter"description = "Shell formatter"
    exclude = List("**/modify_*.toml")
  }
  //

  ["tombi_format"] = (Builtins.tombi_format) {
    //  description = "TOML formatter"
    exclude = List("**/modify_*.toml")
  }
  //

  ["ryl"] = (Builtins.ryl) {
  //    description = "Re-implementation of yamllint in Rust"
  }
  //

  ["ryl_markdown"] = (Builtins.ryl_markdown) {
  //    description = "Lint YAML embedded in Markdown (front matter + fenced yaml blocks) with ryl"
  }
  //

  ["ryl_markdown_format"] = (Builtins.ryl_markdown_format) {
  //    description = "Lint YAML embedded in Markdown (front matter + fenced yaml blocks) with ryl"
  }
  //

  ["shellharden"] = (Builtins.shellharden) {
    //  description = "The corrective bash syntax highlighter"
    //  types = List("bash", "sh")
    exclude = List("**/*.tmpl")
  }
  //

  ["shellcheck"] = (Builtins.shellcheck) {
    //  description = "Shell script analyzer"
    //  FileSelector { glob = List("**/*.sh", "**/*.bash") }
    //  FileSelector { types = List("sh", "bash") }
    exclude = List("**/*.tmpl")
  }
  //

  ["shfmt"] = (Builtins.shfmt) {
    //  description = "Shell formatter"
    //  FileSelector { glob = List("**/*.sh", "**/*.bash", "**/*.mksh", "**/*.bats", "**/*.zsh") }
    //  FileSelector { types = List("sh", "bash") }
    exclude = List("**/*.tmpl")
  }
  //

  ["selene"] = (Builtins.selene) {
  // description = "Lua linter"
  }
  //

  ["editorconfig_checker"] = (Builtins.editorconfig_checker) {
    //  description = "Validate files against EditorConfig rules"
    glob = List("**/.editorconfig", "**/dot_editorconfig")
  }
  //

  ["betterleaks"] = (Builtins.betterleaks) {
  //    description = "A Better Secrets Scanner built for configurability and speed"
  }
  //

  ["render_tasks"] = new Step {
    glob = List("tasks.toml")
    check = "mise run --force render:tasks"
    fix = "mise run --force render:tasks"
    output_summary = "hide"
  }
  //

  ["update_ryl_schema "] = new Step {
    glob = List("ryl")
    check = "mise run --force Update-schema-ryl"
    fix = "mise run --force Update-schema-ryl"
    output_summary = "hide"
  }
  //

  ["mise_config_dir"] = (Builtins.mise_config_dir) {
  //    description = "mise formatter for a global config"
  }
  //

  ["mise"] = (Builtins.mise) {
  //    description = "mise-en-place's built-in formatter and linter"
  }
  //
  ["oxfmt"] = Builtins.oxfmt

  ["ox_lint"] = Builtins.ox_lint
  //

  ["markdown_lint"] = (Builtins.markdown_lint) {
    stage = List("*.md")
  }
  //

}
//
warnings = List("missing-profiles")
//
